<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="equipos" spacing="16.0"
      xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.com.aliprinsa.administracion.gusto.controller.MantenimientosController">

    <stylesheets>
        <URL value="@../css/equipos-view.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0">
            <Label text="Mantenimientos" styleClass="page-title" />
            <Label text="Historial de mantenimientos preventivos y correctivos" styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Nuevo mantenimiento" onAction="#nuevo" styleClass="btn-primario" />
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar por equipo, código, descripción o responsable…"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        <ComboBox fx:id="cmbTipo" prefWidth="150.0" />
        <Button text="Buscar" onAction="#cargar" styleClass="btn-secundario" />
        <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="btn-secundario" />
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" />
            <TableColumn fx:id="colCodigo" text="Código" />
            <TableColumn fx:id="colEquipo" text="Equipo" />
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colDescripcion" text="Descripción" />
            <TableColumn fx:id="colRealizadoPor" text="Realizado por" />
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label fx:id="lblResultados" styleClass="page-subtitle" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="btn-secundario" />
    </HBox>
</VBox>