<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="main-root" prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.com.aliprinsa.administracion.gusto.controller.MainController">

    <stylesheets>
        <URL value="@../css/main-view.css" />
    </stylesheets>

    <!-- Menú lateral -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240.0" minWidth="240.0" spacing="6.0">

            <Label text="Gestión de Equipos" styleClass="sidebar-title" />
            <Label fx:id="lblUsuario" styleClass="sidebar-user" wrapText="true" />

            <Region styleClass="sidebar-separator" prefHeight="1.0" minHeight="1.0" maxHeight="1.0" />

            <Button fx:id="btnDashboard" text="Dashboard" onAction="#irDashboard"
                    styleClass="menu-btn" maxWidth="Infinity" />
            <Button fx:id="btnEquipos" text="Equipos" onAction="#irEquipos"
                    styleClass="menu-btn" maxWidth="Infinity" />
            <Button fx:id="btnAsignaciones" text="Asignaciones" onAction="#irAsignaciones"
                    styleClass="menu-btn" maxWidth="Infinity" />
            <Button fx:id="btnMantenimientos" text="Mantenimientos" onAction="#irMantenimientos"
                    styleClass="menu-btn" maxWidth="Infinity" />
            <Button fx:id="btnUsuarios" text="Usuarios" onAction="#irUsuarios"
                    styleClass="menu-btn" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />

            <Button text="Cerrar sesión" onAction="#cerrarSesion"
                    styleClass="menu-btn-salir" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Área central: aquí se cargan las pantallas -->
    <center>
        <StackPane fx:id="contenido" styleClass="contenido" />
    </center>
</BorderPane>