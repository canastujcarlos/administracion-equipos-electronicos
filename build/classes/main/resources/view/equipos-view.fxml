<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="equipos" spacing="16.0"
      xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.com.aliprinsa.administracion.gusto.controller.EquiposController">

    <stylesheets>
        <URL value="@../css/equipos-view.css" />
    </stylesheets>

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0">
            <Label text="Equipos" styleClass="page-title" />
            <Label text="Inventario de equipos electrónicos" styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Exportar a Excel" onAction="#exportarExcel" styleClass="btn-secundario" />
        <Button text="+ Nuevo equipo" onAction="#nuevo" styleClass="btn-primario" />
    </HBox>

    <!-- Filtros -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar por código, modelo, serie, hostname o marca…"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        <ComboBox fx:id="cmbTipo" promptText="Tipo" prefWidth="150.0" />
        <ComboBox fx:id="cmbEstado" promptText="Estado" prefWidth="160.0" />
        <Button text="Buscar" onAction="#cargar" styleClass="btn-secundario" />
        <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="btn-secundario" />
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" />
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colMarca" text="Marca" />
            <TableColumn fx:id="colModelo" text="Modelo" />
            <TableColumn fx:id="colSerie" text="Serie" />
            <TableColumn fx:id="colUbicacion" text="Ubicación" />
            <TableColumn fx:id="colEstado" text="Estado" />
            <TableColumn fx:id="colResponsable" text="Responsable" />
            <TableColumn fx:id="colGarantia" text="Garantía hasta" />
        </columns>
    </TableView>

    <!-- Pie -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label fx:id="lblResultados" styleClass="page-subtitle" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="btn-secundario" />
        <Button fx:id="btnBaja" text="Dar de baja" onAction="#darDeBaja" styleClass="btn-peligro" />
    </HBox>
</VBox>
