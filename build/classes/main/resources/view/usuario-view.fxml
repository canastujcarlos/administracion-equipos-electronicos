<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="equipos" spacing="16.0"
      xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.com.aliprinsa.administracion.gusto.controller.UsuariosController">

    <stylesheets>
        <URL value="@../css/equipos-view.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0">
            <Label text="Usuarios" styleClass="page-title" />
            <Label text="Cuentas de acceso al sistema" styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Nuevo usuario" onAction="#nuevo" styleClass="btn-primario" />
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, correo o departamento…"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        <ComboBox fx:id="cmbRol" promptText="Rol" prefWidth="160.0" />
        <Button text="Buscar" onAction="#cargar" styleClass="btn-secundario" />
        <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="btn-secundario" />
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colCorreo" text="Correo" />
            <TableColumn fx:id="colDepartamento" text="Departamento" />
            <TableColumn fx:id="colRol" text="Rol" />
            <TableColumn fx:id="colEstado" text="Estado" />
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label fx:id="lblResultados" styleClass="page-subtitle" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnPassword" text="Restablecer contraseña" onAction="#restablecerPassword" styleClass="btn-secundario" />
        <Button fx:id="btnEditar" text="Editar" onAction="#editar" styleClass="btn-secundario" />
    </HBox>
</VBox>